# --- App Configuration ---
# Environment: development, production, test
NODE_ENV=development
PORT=3000

# --- AI Services ---
# Dapatkan API Key dari dashboard provider masing-masing
WAVESPEED_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- AWS Configuration ---
# Pastikan user IAM memiliki akses S3 (PutObject, GetObject)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=my-app-bucket

# --- Database (PostgreSQL/MySQL) ---
# Gunakan localhost untuk pengembangan lokal
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=myapp_db

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Better Stack (Logging) ---
# Get your source token from Better Stack dashboard (EU region)
BETTERSTACK_SOURCE_TOKEN=